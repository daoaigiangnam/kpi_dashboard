APP_NAME="UOA Server Room Management"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://server-room.example.com
APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=uoa_server_room
DB_USERNAME=uoa_app
DB_PASSWORD=CHANGE_ME
DB_CHARSET=utf8mb4

MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="UOA Server Room Management"

QUEUE_BATCH_SIZE=20
QUEUE_MAX_ATTEMPTS=12
QUEUE_STALE_LOCK_MINUTES=15
QUEUE_RETRY_BASE_SECONDS=60
QUEUE_RETRY_MAX_SECONDS=21600
